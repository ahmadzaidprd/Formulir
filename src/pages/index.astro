---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const URL = 'https://script.google.com/macros/s/AKfycbxhzQklS_GeOwBXHoHTnqgeTqNEtwZrkriSRqG4Cg5PQpAeXcj3-oOELwQ0vDHguk7W/exec';
let produk = [];
try {
    const res = await fetch(URL);
    produk = await res.json();
} catch (e) {
    console.error(e);
}
---

<Layout>
    <div x-data={`{
        nama: '',
        alamat: '',
        noWA: '',
        statusAnggota: 'Non Anggota',
        statusPengiriman: 'Ambil Sendiri',
        metodeBayar: 'Tunai',
        showModal: false,
        produk: ${JSON.stringify(produk)},
        keranjang: {},
        
        tambah(id) { this.keranjang[id] = (this.keranjang[id] || 0) + 1 },
        kurang(id) { if(this.keranjang[id] > 0) this.keranjang[id]-- },
        
        getSubtotal() {
            return this.produk.reduce((t, p) => t + ((this.keranjang[p['Nama Product']] || 0) * p['Harga']), 0);
        },
        
        getBiayaKirim() {
            return this.statusPengiriman === 'Diantar ke Rumah' ? 10000 : 0;
        },
        
        getGrandTotal() {
            return this.getSubtotal() + this.getBiayaKirim();
        },

        validasi() {
            if(!this.nama || !this.alamat) return alert('Nama dan Alamat wajib diisi!');
            if(this.getSubtotal() === 0) return alert('Pilih barang dulu!');
            this.showModal = true;
        },
        
        kirimWA() {
            let t = 'STRUK PESANAN WARUNG ZAIDLY\\n';
            t += '-------------------------------\\n';
            t += '👤 Pelanggan: ' + this.nama + '\\n';
            t += '📍 Alamat: ' + this.alamat + '\\n';
            t += '📱 No WA: ' + this.noWA + '\\n';
            t += '🎖️ Status: ' + this.statusAnggota + '\\n';
            t += '-------------------------------\\n\\n';
            t += 'DETAIL PESANAN:\\n';
            
            this.produk.forEach(p => {
                let qty = this.keranjang[p['Nama Product']];
                if(qty > 0) {
                    t += '* ' + p['Nama Product'] + '\\n';
                    t += '  ' + qty + ' x Rp' + p['Harga'].toLocaleString('id-ID') + ' = Rp' + (qty * p['Harga']).toLocaleString('id-ID') + '\\n';
                }
            });
            
            t += '\\n-------------------------------\\n';
            t += 'Subtotal: Rp ' + this.getSubtotal().toLocaleString('id-ID') + '\\n';
            t += 'Ongkir: Rp ' + this.getBiayaKirim().toLocaleString('id-ID') + '\\n';
            t += 'GRAND TOTAL: Rp ' + this.getGrandTotal().toLocaleString('id-ID') + '\\n';
            t += '-------------------------------\\n\\n';
            
            t += 'INFO PEMBAYARAN:\\n';
            t += (this.metodeBayar === 'Transfer' ? 'Silahkan transfer ke *BCA 12345678* a/n Zaid.\\n' : 'Pembayaran Tunai saat pengambilan/pengantaran.\\n');
            
            t += '\\nPENGIRIMAN:\\n';
            t += (this.statusPengiriman === 'Ambil Sendiri' ? 'Produk silakan diambil ke tempat.\\n' : 'Produk akan diantar ke alamat Anda (Ada biaya lain-lain/ongkir).\\n');
            
            window.open('https://wa.me/6281274203815?text=' + encodeURIComponent(t));
            this.showModal = false;
        }
    }`}>
        
        <header class="bg-red-600 text-white p-5 sticky top-0 z-50 shadow-md border-b-4 border-red-800 text-center">
            <h1 class="text-lg font-black tracking-tight uppercase">Formulir Pemesanan Sembako</h1>
        </header>

        <main class="max-w-md mx-auto p-4 pb-48">
            <section class="bg-white p-6 rounded-[2.5rem] shadow-xl border border-red-50 mb-8 space-y-5">
                <div class="relative">
                    <label class="text-[10px] font-black text-red-600 uppercase tracking-widest ml-1">Identitas Pembeli</label>
                    <input type="text" x-model="nama" placeholder="Nama Lengkap" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 transition-all">
                    <textarea x-model="alamat" placeholder="Alamat Lengkap (Jl, No Rumah, RT/RW)" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 h-16 resize-none transition-all"></textarea>
                    <input type="number" x-model="noWA" placeholder="Nomor WA (08xxx)" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 transition-all">
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Status</label>
                        <select x-model="statusAnggota" class="w-full bg-slate-100 p-3 rounded-2xl text-xs font-bold outline-none focus:ring-2 focus:ring-red-500">
                            <option>Non Anggota</option>
                            <option>Anggota</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Bayar</label>
                        <select x-model="metodeBayar" class="w-full bg-slate-100 p-3 rounded-2xl text-xs font-bold outline-none focus:ring-2 focus:ring-red-500">
                            <option>Tunai</option>
                            <option>Transfer</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Opsi Pengiriman</label>
                    <select x-model="statusPengiriman" class="w-full bg-slate-100 p-3 rounded-2xl text-xs font-bold outline-none focus:ring-2 focus:ring-red-500">
                        <option>Ambil Sendiri</option>
                        <option>Diantar ke Rumah</option>
                    </select>
                </div>
            </section>
            
            <div class="grid grid-cols-2 gap-4">
                {produk.map((p) => (
                    <Card nama={p['Nama Product']} harga={p['Harga']} stok={p['Stok']} />
                ))}
            </div>
        </main>

        <footer class="fixed bottom-0 left-0 right-0 p-5 bg-white/95 backdrop-blur-xl border-t-2 border-red-100 z-50 flex justify-center">
             <div class="max-w-md w-full flex justify-between items-center px-2">
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Grand Total</span>
                    <span class="text-2xl font-[900] text-red-600 leading-none" x-text="'Rp ' + getGrandTotal().toLocaleString('id-ID')"></span>
                </div>
                <button @click="validasi()" class="bg-red-600 hover:bg-red-700 text-white px-10 py-4 rounded-2xl font-black shadow-xl shadow-red-200 active:scale-95 transition-all uppercase text-xs tracking-widest">
                    Cek Struk
                </button>
            </div>
        </footer>

        <div x-show="showModal" x-transition.opacity class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-sm">
            <div @click.away="showModal = false" class="bg-white w-full max-w-sm rounded-[3rem] overflow-hidden shadow-2xl animate-in zoom-in-95 duration-200">
                <div class="p-8">
                    <h2 class="text-center font-[900] text-slate-800 text-xl mb-6 uppercase tracking-tight">Detail Pesanan</h2>
                    
                    <div class="bg-slate-50 rounded-[2rem] p-6 mb-6 max-h-72 overflow-y-auto border border-slate-100">
                        <p class="font-black text-red-600 border-b-2 border-dashed border-slate-200 pb-3 mb-4 text-center" x-text="nama"></p>
                        <template x-for="p in produk">
                            <div x-show="keranjang[p['Nama Product']] > 0" class="flex flex-col py-2 border-b border-slate-100 last:border-0">
                                <span class="font-bold text-slate-800 text-sm" x-text="p['Nama Product']"></span>
                                <div class="flex justify-between text-xs text-slate-500">
                                    <span x-text="keranjang[p['Nama Product']] + ' x Rp' + p['Harga'].toLocaleString('id-ID')"></span>
                                    <span class="font-black text-slate-700" x-text="'Rp ' + (keranjang[p['Nama Product']] * p['Harga']).toLocaleString('id-ID')"></span>
                                </div>
                            </div>
                        </template>
                        
                        <div class="mt-4 pt-3 space-y-1 text-xs">
                            <div class="flex justify-between text-slate-400 font-bold">
                                <span>SUBTOTAL</span>
                                <span x-text="'Rp ' + getSubtotal().toLocaleString('id-ID')"></span>
                            </div>
                            <div class="flex justify-between text-slate-400 font-bold" x-show="getBiayaKirim() > 0">
                                <span>ONGKIR</span>
                                <span x-text="'Rp ' + getBiayaKirim().toLocaleString('id-ID')"></span>
                            </div>
                            <div class="flex justify-between font-black text-red-600 text-lg pt-2">
                                <span>TOTAL</span>
                                <span x-text="'Rp ' + getGrandTotal().toLocaleString('id-ID')"></span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <button @click="kirimWA()" class="w-full py-5 font-black text-white bg-green-600 rounded-[1.5rem] shadow-xl shadow-green-100 uppercase text-xs tracking-widest">Pesan Sekarang</button>
                        <button @click="showModal = false" class="w-full py-3 font-bold text-slate-400 hover:text-slate-600 transition-colors uppercase text-[10px] tracking-widest">Batal / Edit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>