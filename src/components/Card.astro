---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

// 1. Bagian atas kita kosongkan dari fetch biar GAK LEMOT
const URL = 'https://script.google.com/macros/s/AKfycbxhzQklS_GeOwBXHoHTnqgeTqNEtwZrkriSRqG4Cg5PQpAeXcj3-oOELwQ0vDHguk7W/exec';
---

<Layout>
    <div x-data={`{
        nama: '',
        alamat: '',
        noWA: '',
        statusAnggota: 'Non Anggota',
        statusPengiriman: 'Ambil Sendiri',
        metodeBayar: 'Tunai',
        showModal: false,
        produk: [], // Mulai dari kosong
        keranjang: {},
        isLoading: true,
        
        async ambilDataTerbaru() {
            this.isLoading = true;
            try {
                const res = await fetch('${URL}');
                const data = await res.json();
                this.produk = data;
            } catch (e) { 
                console.log("Gagal update data"); 
            } finally {
                this.isLoading = false;
            }
        },
        
        tambah(id) { this.keranjang[id] = (this.keranjang[id] || 0) + 1 },
        kurang(id) { if(this.keranjang[id] > 0) this.keranjang[id]-- },
        
        getSubtotal() {
            return this.produk.reduce((t, p) => t + ((this.keranjang[p['Nama Product']] || 0) * p['Harga']), 0);
        },
        
        getBiayaKirim() { return 0; },
        getGrandTotal() { return this.getSubtotal(); },

        validasi() {
            if(!this.nama || !this.alamat) return alert('Nama dan Alamat wajib diisi!');
            if(this.getSubtotal() === 0) return alert('Pilih barang dulu!');
            this.showModal = true;
        },
        
        async kirimWA() {
            let daftar = "";
            this.produk.forEach(p => {
                let qty = this.keranjang[p['Nama Product']];
                if(qty > 0) daftar += p['Nama Product'] + " (" + qty + "), ";
            });

            let statusStruk = "";
            let infoTambahan = "";

            if (this.metodeBayar === 'Tunai') {
                statusStruk = "COD / BAYAR DI TEMPAT";
                infoTambahan = "Silakan siapkan uang pas saat pengambilan/pengantaran barang.";
            } else if (this.metodeBayar === 'Transfer') {
                statusStruk = "MENUNGGU BUKTI TRANSFER";
                infoTambahan = "Silakan transfer ke Rek. *Mandiri 1760006571986* a/n Koperasi Merah Putih. Mohon lampirkan foto bukti transfer setelah ini.";
            } else if (this.metodeBayar === 'Kredit') {
                statusStruk = "MENUNGGU APPROVAL";
                infoTambahan = "Pesanan akan dicek oleh pengurus Koperasi untuk persetujuan limit kredit anggota.";
            }

            try {
                fetch('${URL}', {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify({
                        nama: this.nama,
                        alamat: this.alamat,
                        nowa: this.noWA,
                        pesanan: daftar,
                        total: this.getGrandTotal(),
                        metode: this.metodeBayar
                    })
                });
            } catch (e) { console.log("Gagal catat"); }

            let t = 'STRUK PESANAN KOPERASI MERAH PUTIH\\n';
            t += 'DESA CIKASUNGKA\\n';
            t += '-------------------------------\\n';
            t += '👤 Pelanggan: ' + this.nama + '\\n';
            t += '📍 Alamat: ' + this.alamat + '\\n';
            t += '💳 Metode: *' + this.metodeBayar + '*\\n';
            t += '📝 Status: *' + statusStruk + '*\\n';
            t += '🚚 Kirim: ' + this.statusPengiriman + ' (Gratis)\\n';
            t += '-------------------------------\\n\\n';
            t += 'DETAIL PESANAN:\\n' + daftar + '\\n\\n';
            t += 'TOTAL BAYAR: Rp ' + this.getGrandTotal().toLocaleString('id-ID') + '\\n';
            t += '-------------------------------\\n\\n';
            t += '*INFO PEMBAYARAN*:\\n' + infoTambahan;

            window.open('https://wa.me/6281217476659?text=' + encodeURIComponent(t));
            this.showModal = false;
        }
    }`} x-init="ambilDataTerbaru()">
        
        <header class="bg-red-600 text-white p-5 sticky top-0 z-50 shadow-md border-b-4 border-red-800 text-center">
            <h1 class="text-sm font-black tracking-tight uppercase leading-tight">Koperasi Merah Putih<br/>Desa Cikasungka</h1>
        </header>

        <main class="max-w-md mx-auto p-4 pb-48">
            <section class="bg-white p-6 rounded-[2.5rem] shadow-xl border border-red-50 mb-8 space-y-5">
                <div class="relative">
                    <label class="text-[10px] font-black text-red-600 uppercase tracking-widest ml-1">Identitas Pembeli</label>
                    <input type="text" x-model="nama" placeholder="Nama Lengkap" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 transition-all">
                    <textarea x-model="alamat" placeholder="Alamat Lengkap" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 h-16 resize-none transition-all"></textarea>
                    <input type="number" x-model="noWA" placeholder="Nomor WA (08xxx)" class="w-full border-b-2 border-slate-100 py-3 outline-none focus:border-red-500 font-bold text-slate-700 transition-all">
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Metode Bayar</label>
                        <select x-model="metodeBayar" class="w-full bg-slate-100 p-3 rounded-2xl text-xs font-bold outline-none focus:ring-2 focus:ring-red-500">
                            <option value="Tunai">Tunai</option>
                            <option value="Transfer">Transfer Bank</option>
                            <option value="Kredit">Kredit</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Pengiriman</label>
                        <select x-model="statusPengiriman" class="w-full bg-slate-100 p-3 rounded-2xl text-xs font-bold outline-none focus:ring-2 focus:ring-red-500">
                            <option value="Ambil Sendiri">Ambil Sendiri</option>
                            <option value="Diantar ke Rumah">Diantar</option>
                        </select>
                    </div>
                </div>
            </section>
            
            <template x-if="isLoading">
                <div class="col-span-2 text-center py-10">
                    <p class="text-sm font-bold text-slate-400 animate-pulse">Mengambil data sembako...</p>
                </div>
            </template>

            <div class="grid grid-cols-2 gap-4">
                <template x-for="p in produk" :key="p['Nama Product']">
                    <Card 
                        :nama="p['Nama Product']" 
                        :harga="p['Harga']" 
                        :stok="p['Stok']" 
                    />
                </template>
            </div>
        </main>

        <footer class="fixed bottom-0 left-0 right-0 p-5 bg-white/95 backdrop-blur-xl border-t-2 border-red-100 z-50 flex justify-center">
             <div class="max-w-md w-full flex justify-between items-center px-2">
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Grand Total</span>
                    <span class="text-2xl font-[900] text-red-600 leading-none" x-text="'Rp ' + getGrandTotal().toLocaleString('id-ID')"></span>
                </div>
                <button @click="validasi()" class="bg-red-600 hover:bg-red-700 text-white px-10 py-4 rounded-2xl font-black shadow-xl shadow-red-200 active:scale-95 transition-all uppercase text-xs tracking-widest">
                    Cek Struk
                </button>
            </div>
        </footer>

        <div x-show="showModal" x-transition.opacity class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-sm" x-cloak>
            <div @click.away="showModal = false" class="bg-white w-full max-w-sm rounded-[3rem] overflow-hidden shadow-2xl animate-in zoom-in-95 duration-200">
                <div class="p-8 text-center">
                    <h2 class="font-[900] text-slate-800 text-xl mb-4 uppercase">Detail Pesanan</h2>
                    <div class="bg-slate-50 rounded-[2rem] p-6 mb-6 text-left">
                        <div class="mb-4 pb-2 border-b border-dashed border-slate-300 text-center">
                            <p class="text-[10px] font-bold text-slate-400 uppercase">Metode Pembayaran</p>
                            <p class="font-black text-red-600" x-text="metodeBayar"></p>
                        </div>

                        <div class="space-y-2 mb-4">
                            <template x-for="p in produk">
                                <div x-show="keranjang[p['Nama Product']] > 0" class="flex justify-between text-xs font-bold text-slate-700">
                                    <span x-text="p['Nama Product']"></span>
                                    <span x-text="keranjang[p['Nama Product']] + 'x'"></span>
                                </div>
                            </template>
                        </div>
                        
                        <div class="border-t border-dashed border-slate-300 pt-4">
                            <p class="flex justify-between font-black text-slate-800 text-lg">
                                <span>Total</span>
                                <span x-text="'Rp ' + getGrandTotal().toLocaleString('id-ID')"></span>
                            </p>
                            <p class="text-[10px] text-green-600 font-bold mt-1 text-center">*Gratis Biaya Ongkir</p>
                        </div>
                    </div>
                    <button @click="kirimWA()" class="w-full py-5 font-black text-white bg-green-600 rounded-[1.5rem] uppercase text-xs tracking-widest mb-2 shadow-lg shadow-green-200 active:scale-95 transition-all">
                        Kirim ke WA
                    </button>
                    <button @click="showModal = false" class="text-[10px] font-bold text-slate-400 uppercase cursor-pointer">Batal</button>
                </div>
            </div>
        </div>
    </div>
</Layout>